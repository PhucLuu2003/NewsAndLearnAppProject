rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Profile pictures - allow users to upload their own avatars
    match /profile_pictures/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }


    // User recordings for speaking lessons
    match /speaking_recordings/{userId}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Writing submissions
    match /writing_submissions/{userId}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Public resources (videos, images for lessons)
    match /public/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Catch-all: deny by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

