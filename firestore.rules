rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================
    // HELPER FUNCTIONS
    // =========================
    function isAuth() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuth()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Allow authenticated users to update ONLY downloadCount (used by VocabularyHelper)
    function isOnlyDownloadCountUpdate() {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly(['downloadCount'])
        && request.resource.data.downloadCount is int
        && resource.data.downloadCount is int
        && request.resource.data.downloadCount >= resource.data.downloadCount;
    }

    // =========================
    // USERS - CHO PHÉP ĐỌC TẤT CẢ ĐỂ XEM LEADERBOARD
    // =========================
    match /users/{userId} {
      allow read: if isAuth();

      // Create: user can create own profile, but cannot self-assign admin
      allow create: if isOwner(userId)
        && (!('role' in request.resource.data) || request.resource.data.role == 'user');

      // Update: owner can update profile but cannot change role; admin can update anyone (including role)
      allow update: if (isOwner(userId) && request.resource.data.role == resource.data.role)
        || isAdmin();

      allow delete: if isOwner(userId) || isAdmin();

      match /{sub=**} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // =========================
    // USER DATA NGOAI USERS
    // =========================
    match /daily_goals/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /module_progress/{progressId} {
      allow read, write: if isAuth();
    }

    // =========================
    // ARTICLES
    // =========================
    match /articles/{articleId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // =========================
    // VOCABULARY
    // =========================
    match /vocabularies/{vocabId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    match /vocabulary_sets/{setId} {
      allow read: if isAuth();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (isAuth() && isOnlyDownloadCountUpdate());

      match /words/{wordId} {
        allow read: if isAuth();
        allow write: if isAdmin();
      }
    }

    // =========================
    // SURVIVAL VOCABULARY (New Feature)
    // =========================
    match /vocabulary_categories/{categoryId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    match /survival_words/{wordId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // =========================
    // PHONICS FOUNDATION (New Feature)
    // =========================
    match /phonics_lessons/{lessonId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // =========================
    // READING
    // =========================
    match /reading_articles/{articleId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    match /reading_lessons/{lessonId} {
      allow read: if isAuth();
      allow write: if isAdmin();

      match /{sub=**} {
        allow read: if isAuth();
        allow write: if isAdmin();
      }
    }

    // =========================
    // WRITING
    // =========================
    match /writing_lessons/{lessonId} {
      allow read: if isAuth();
      allow write: if isAdmin();

      match /{sub=**} {
        allow read: if isAuth();
        allow write: if isAdmin();
      }
    }

    // =========================
    // LISTENING
    // =========================
    match /listening_lessons/{lessonId} {
      allow read: if isAuth();
      allow write: if isAdmin();

      match /{sub=**} {
        allow read: if isAuth();
        allow write: if isAdmin();
      }
    }

    // =========================
    // SPEAKING
    // =========================
    match /speaking_lessons/{lessonId} {
      allow read: if isAuth();
      allow write: if isAdmin();

      match /{sub=**} {
        allow read: if isAuth();
        allow write: if isAdmin();
      }
    }

    // =========================
    // GRAMMAR
    // =========================
    match /grammar_lessons/{lessonId} {
      allow read: if isAuth();
      allow write: if isAdmin();

      match /{sub=**} {
        allow read: if isAuth();
        allow write: if isAdmin();
      }
    }

    // =========================
    // VIDEO
    // =========================
    match /video_lessons/{lessonId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // =========================
    // FLASHCARD / QUIZ
    // =========================
    match /flashcard_decks/{deckId} {
      allow read: if isAuth();
      allow write: if isAdmin();

      match /cards/{cardId} {
        allow read: if isAuth();
        allow write: if isAdmin();
      }
    }

    match /quiz_templates/{quizId} {
      allow read: if isAuth();
      allow write: if isAdmin();

      match /questions/{questionId} {
        allow read: if isAuth();
        allow write: if isAdmin();
      }
    }

    // =========================
    // RPG
    // =========================
    match /rpg_characters/{id} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    match /rpg_enemies/{id} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    match /rpg_items/{id} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    match /rpg_battles/{id} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // Game Levels for Vocabulary RPG
    match /game_levels/{levelId} {
      allow read: if isAuth();
      allow write: if isAuth(); // Allow authenticated users to seed data
    }

    // Game Enemies for Vocabulary RPG
    match /game_enemies/{enemyId} {
      allow read: if isAuth();
      allow write: if isAuth(); // Allow authenticated users to seed data
    }

    // Game Questions for Vocabulary RPG
    match /game_questions/{questionId} {
      allow read: if isAuth();
      allow write: if isAuth(); // Allow authenticated users to seed data
    }

    // =========================
    // SYSTEM
    // =========================
    match /app_config/{id} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    match /announcements/{id} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    match /test/{id} {
      allow read, write: if isAuth();
    }

    // =========================
    // ANALYTICS
    // =========================
    match /analytics/{id} {
      allow read, write: if isAuth();
    }

    match /activity_logs/{logId} {
      allow read, write: if isAuth();
    }

    // =========================
    // COMMENTS
    // =========================
    match /comments/{commentId} {
      allow read, write: if isAuth();
    }

    // =========================
    // LEADERBOARD
    // =========================
    match /leaderboards/{id} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // =========================
    // ENGLISH MILLIONAIRE GAME
    // =========================
    match /millionaire_questions/{questionId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }
  }
}
